PORT=8080
JWT_SECRET=replace-with-secure-secret
MAX_INTENTS_PER_MINUTE=120
DEV_AUTH_ENABLED=true
GATEWAY_DB_PATH=./gateway.db

# SpacetimeDB connection — run `spacetime login show --token` to get your token
# Use the db_identity from `spacetime list --server maincloud` for STDB_DATABASE
STDB_URI=wss://maincloud.spacetimedb.com
STDB_DATABASE=<db_identity_hex_from_spacetime_list>
STDB_TOKEN=<token_from_spacetime_login_show>
CLIENT_WORLD_ID=finite-earth-alpha

# MegaETH chain relay (chain ID 6342)
MEGAETH_RPC_URL=https://rpc.megaeth.com
RELAYER_PRIVATE_KEY=<relayer-private-key>
GLOBAL_COUNTERS_ADDRESS=<deployed-global-counters-address>
# Set after running: cd blockchain && npm run deploy:megaeth
TILE_NFT_ADDRESS=
FOREST_TOKEN_ADDRESS=
CARBON_TOKEN_ADDRESS=
CHAIN_RELAY_POLL_MS=3000
